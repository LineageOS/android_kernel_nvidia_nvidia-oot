load("//build/kernel/kleaf:kernel.bzl", "ddk_headers", "ddk_module")
load("//build/kernel/kleaf:hermetic_tools.bzl", "hermetic_genrule")

package(default_visibility = ["//vendor/nvidia:__subpackages__"])

alias(
    name = "kernel",
    actual = "//vendor/nvidia/tegra:kernel_tegra",
)

ddk_headers(
    name = "uapi_headers",
    hdrs = glob([
        "include/uapi/**/*.h",
    ]),
    includes = ["include",],
)

# Common headers
ddk_headers(
    name = "nvidia-oot_common_headers",
    hdrs = glob([
        "include/devfreq/**/*.h",
        "include/dt-bindings/**/*.h",
        "include/linux/**/*.h",
        "include/soc/**/*.h",
        "include/sound/**/*.h",
        "include/trace/**/*.h",
    ]),
    includes = ["include",],
)

filegroup(
    name = "nvidia-oot_openrm_headers",
    srcs = [
        "include/linux/platform/tegra/dce/dce-client-ipc.h",
        "include/linux/platform/tegra/mc_utils.h",
        "include/dt-bindings/interconnect/tegra_icc_id.h",
        "include/linux/nvhost.h",
        "include/linux/nvhost_t194.h",
    ],
)

hermetic_genrule(
    name = "conftest",
    srcs = [
        "scripts/conftest/conftest.h",
        "//vendor/nvidia/kernel:kernel_aarch64",
        "//vendor/nvidia/kernel:kernel_aarch64_headers",
        "//vendor/nvidia/kernel:kernel_aarch64_sources",
    ],
    outs = [
        "scripts/conftest/nvidia/conftest.h",
        "scripts/conftest/nvidia/conftest/functions.h",
        "scripts/conftest/nvidia/conftest/generic.h",
        "scripts/conftest/nvidia/conftest/headers.h",
        "scripts/conftest/nvidia/conftest/macros.h",
        "scripts/conftest/nvidia/conftest/patches.h",
        "scripts/conftest/nvidia/conftest/symbols.h",
        "scripts/conftest/nvidia/conftest/types.h",
    ],
    cmd = """
        mkdir -p out
        tar -xzf $$(find bazel-out/ -name kernel-headers.tar.gz -print -quit) -C out
        cp $$(find bazel-out/ -name kernel_aarch64_Module.symvers -print -quit) out/kernel-headers/Module.symvers
        export NV_KERNEL_SOURCES=$$(realpath vendor/nvidia/kernel)
        export NV_KERNEL_OUTPUT=$$(realpath out/kernel-headers)
        export ARCH=arm64
        export src=$$(dirname $(location scripts/conftest/conftest.sh))
        export obj=$(@D)/scripts/conftest/nvidia
        export IGNORE_CC_MISMATCH=1
        export CC="clang --target=aarch64-linux-gnu"
        export EXTRA_CFLAGS="-I$$(realpath $$obj) -Wno-pointer-sign -Wno-gnu-variable-sized-type-not-at-end -Wno-unused-value -Wno-return-type"
        make -f $(location scripts/conftest/Makefile)
        cp $(location scripts/conftest/conftest.h) $(@D)/scripts/conftest/nvidia/
    """,
    tools = [
      "scripts/conftest/conftest.sh",
      "scripts/conftest/Makefile",
    ],
    use_cc_toolchain = True,
)
ddk_headers(
    name = "conftest_headers",
    hdrs = [":conftest",],
    includes = ["scripts/conftest"],
)


